// `bun scripts/review-props.mts --names a,b|--file names.txt --out dir [--props '{"scale":0.8}'] [--cases '{"slow":{"speed":0.5}}'] [--defaults] [--at 0.6,0.25|all] [--scale 0.25] [--concurrency 6]`
//
// Renders stills of registry components through `src/remotion/props-review-root.tsx`:
// one PNG per component per moment (`--at` is a share of each component's
// duration, or `all` for every frame). Used to check that new props keep the
// default render unchanged and visibly do something when set, and with
// `--at all --scale 1` that a refactor keeps every frame to the pixel.
// `--defaults` starts every component from its config's defaults, as the docs
// preview renders it, for components whose copy has no default in code.
// `--cases` renders several prop sets from one bundle, each into its own
// folder under `--out`; `--props` then applies to all of them.
//
// The bundle holds only the named components: the full preview index makes
// webpack compile every component in the registry.
import { mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import path from "node:path";
import { bundle } from "@remotion/bundler";
import {
  getCompositions,
  makeCancelSignal,
  openBrowser,
  renderFrames,
  renderStill,
} from "@remotion/renderer";
import { tsconfigWebpackAlias } from "./tsconfig-webpack-alias.mts";

const flag = (name: string) => {
  const i = process.argv.indexOf(`--${name}`);
  return i === -1 ? undefined : process.argv[i + 1];
};
const root = process.cwd();
const names = (
  flag("file")
    ? readFileSync(flag("file") as string, "utf8")
    : (flag("names") ?? "")
)
  .split(/[\s,]+/)
  .filter(Boolean);
const out = path.resolve(flag("out") ?? "out/review-props");
const props = JSON.parse(flag("props") ?? "{}") as Record<string, unknown>;
const cases = flag("cases")
  ? (JSON.parse(flag("cases") as string) as Record<
      string,
      Record<string, unknown>
    >)
  : null;
const every = flag("at") === "all";
const at = every ? [] : (flag("at") ?? "0.6").split(",").map(Number);
const scale = Number(flag("scale") ?? "0.25");
const concurrency = Number(flag("concurrency") ?? "6");
mkdirSync(out, { recursive: true });

/** The entries of `registry/__index__.tsx` for `names`, as a module of its own. */
function registrySubset(): string {
  const index = readFileSync(path.join(root, "registry/__index__.tsx"), "utf8");
  const entries = names.map((name) => {
    // A key that is a plain identifier is written without quotes.
    const quoted = index.indexOf(`\n  ${JSON.stringify(name)}: {\n`);
    const start = quoted === -1 ? index.indexOf(`\n  ${name}: {\n`) : quoted;
    if (start === -1) throw new Error(`No preview named "${name}"`);
    const end = index.indexOf("\n  },\n", start);
    return index.slice(start + 1, end + 5);
  });
  // One file per run: parallel runs in one checkout must not bundle each
  // other's subset.
  const file = path.join(
    root,
    `out/.review-props/registry-subset-${process.pid}.tsx`,
  );
  mkdirSync(path.dirname(file), { recursive: true });
  writeFileSync(
    file,
    `// biome-ignore-all lint: generated by scripts/review-props.mts
import type { RegistryEntry } from "@/registry/__index__";

const registry: Record<string, RegistryEntry> = {
${entries.join("\n")}
};

export default registry;
`,
  );
  return file;
}

const serveUrl =
  flag("serve") ??
  (await bundle({
    entryPoint: path.join(root, "src/remotion/props-review-root.tsx"),
    webpackOverride: (config) => ({
      ...config,
      resolve: {
        ...config.resolve,
        alias: [
          // Only the root's own import of the index; the type import in the
          // subset still reads the real file.
          {
            name: "@/registry/__index__",
            alias: registrySubset(),
            onlyModule: true,
          },
          ...Object.entries(config.resolve?.alias ?? {}).map(
            ([name, alias]) => ({
              name: name.replace(/\$$/, ""),
              alias: alias as string,
              onlyModule: name.endsWith("$"),
            }),
          ),
          ...tsconfigWebpackAlias(root),
        ],
      },
    }),
  }));
const defaults = process.argv.includes("--defaults");
const browser = await openBrowser("chrome", {
  chromiumOptions: { gl: "angle" },
});
const failed: string[] = [];
try {
  for (const [label, caseProps] of Object.entries(cases ?? { "": {} })) {
    const dir = label ? path.join(out, label) : out;
    mkdirSync(dir, { recursive: true });
    const inputProps = {
      names,
      props: { ...props, ...caseProps },
      defaults,
    };
    const compositions = await getCompositions(serveUrl, {
      inputProps,
      puppeteerInstance: browser,
    });
    let i = 0;
    for (const composition of compositions) {
      i += 1;
      try {
        if (every) {
          // One pass over every frame, across several tabs.
          const pad = String(composition.durationInFrames - 1).length;
          // A component that throws leaves renderFrames waiting rather than
          // failing, so a run gets a deadline sized to the clip.
          const { cancelSignal, cancel } = makeCancelSignal();
          const deadline = setTimeout(
            cancel,
            60_000 + composition.durationInFrames * 1_000,
          );
          await renderFrames({
            cancelSignal,
            serveUrl,
            composition,
            inputProps,
            outputDir: null,
            imageFormat: "png",
            scale,
            concurrency,
            puppeteerInstance: browser,
            chromiumOptions: { gl: "angle" },
            onStart: () => undefined,
            onFrameUpdate: () => undefined,
            onFrameBuffer: (buffer, frame) => {
              const tag = String(frame).padStart(Math.max(4, pad), "0");
              writeFileSync(
                path.join(dir, `${composition.id}@${tag}.png`),
                buffer,
              );
            },
          }).finally(() => clearTimeout(deadline));
        } else {
          for (const share of at) {
            const frame = Math.min(
              composition.durationInFrames - 1,
              Math.round(composition.durationInFrames * share),
            );
            await renderStill({
              serveUrl,
              composition,
              frame,
              output: path.join(dir, `${composition.id}@${share}.png`),
              inputProps,
              scale,
              puppeteerInstance: browser,
              chromiumOptions: { gl: "angle" },
            });
          }
        }
      } catch (error) {
        failed.push(
          `${label ? `${label}/` : ""}${composition.id}: ${String(error).split("\n")[0]}`,
        );
      }
      process.stdout.write(
        `\r${label ? `${label} ` : ""}${i}/${compositions.length}   `,
      );
    }
    if (label) process.stdout.write("\n");
  }
} finally {
  await browser.close({ silent: true });
  // A bundle is a few hundred MB in the system temp folder; one made here is
  // not reused.
  if (!flag("serve")) rmSync(serveUrl, { recursive: true, force: true });
}
console.log(`\n${failed.length} failed`);
for (const line of failed) console.log(line);

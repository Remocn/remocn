{
  "name": "remocn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio:release-teaser": "remotion studio src/remotion/release-teaser-root.tsx",
    "review:release-teaser": "bun scripts/review-release-teaser.mts",
    "render:release-teaser": "bun scripts/review-release-teaser.mts --render",
    "studio:brand-guidelines": "remotion studio src/remotion/brand-guidelines-root.tsx",
    "review:brand-guidelines": "bun scripts/review-brand-guidelines.mts",
    "render:brand-guidelines": "bun scripts/review-brand-guidelines.mts --render",
    "studio:independent-templates": "remotion studio src/remotion/independent-templates-root.tsx",
    "review:independent-templates": "bun scripts/review-independent-templates.mts",
    "render:independent-templates": "bun scripts/review-independent-templates.mts --render",
    "studio:workflow-console": "remotion studio src/remotion/workflow-console-root.tsx",
    "review:workflow-console": "bun scripts/review-workflow-console.mts",
    "render:workflow-console": "bun scripts/render-workflow-console.mts",
    "studio:launch-anything": "remotion studio src/remotion/launch-anything-root.tsx",
    "render:launch-anything": "bun scripts/render-launch-anything.mts",
    "review:launch-anything": "bun scripts/review-launch-anything.mts",
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "sponsors:readme": "bun scripts/sponsors-readme.mts",
    "lint": "biome check",
    "format": "biome format --write",
    "registry:build": "shadcn build --output registry-artifacts && bun scripts/build-elements.mts && biome format --write registry-artifacts",
    "registry:check": "shadcn build --output registry-artifacts && bun scripts/build-elements.mts && biome format --write registry-artifacts && git diff --quiet -- registry-artifacts || (echo 'registry-artifacts is out of sync with registry/ sources. Run: bun run registry:build and commit the result.' && exit 1)",
    "manifest:build": "bun scripts/build-preview-manifest.mts && biome format --write registry/__manifest__.ts",
    "manifest:check": "bun run manifest:build && git diff --quiet -- registry/__manifest__.ts || (echo 'registry/__manifest__.ts is out of sync with registry config sources. Run: bun run manifest:build and commit the result.' && exit 1)",
    "studio": "remotion studio",
    "remotion:browser": "bun scripts/ensure-browser.mts",
    "bundle:remotion": "bun scripts/bundle-remotion.mts",
    "render:demos": "bun scripts/render-demos.mts",
    "spike:canvas": "bun scripts/canvas-determinism.mts",
    "render:not-found": "bun scripts/render-not-found.mts",
    "postinstall": "fumadocs-mdx",
    "studio:fomo": "remotion studio src/remotion/fomo-root.tsx",
    "render:fomo": "bun scripts/render-fomo.mts",
    "review:fomo": "bun scripts/review-fomo.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/roboto-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@openpanel/nextjs": "^1.0.13",
    "@openpanel/sdk": "^1.3.1",
    "@paper-design/shaders-react": "0.0.76",
    "@remotion/bundler": "4.0.513",
    "@remotion/google-fonts": "4.0.513",
    "@remotion/paths": "4.0.513",
    "@remotion/player": "4.0.513",
    "@remotion/renderer": "4.0.513",
    "@remotion/studio-protocol": "4.0.513",
    "@remotion/transitions": "4.0.513",
    "@remotion/zod-types": "4.0.513",
    "@shadcn/react": "^0.1.0",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.1",
    "date-fns": "^4.1.0",
    "fumadocs-core": "^16.7.10",
    "fumadocs-mdx": "^14.2.11",
    "fumadocs-ui": "^16.7.10",
    "jotai": "^2.19.1",
    "json5": "^2.2.3",
    "lucide-react": "^1.7.0",
    "motion": "^12.40.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "ogl": "^1.0.11",
    "opentype.js": "^2.0.0",
    "p-limit": "^6.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.9.0",
    "rehype-pretty-code": "^0.14.4",
    "remotion": "4.0.513",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "takumi-js": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@remotion/cli": "4.0.513",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "latest",
    "@types/culori": "^4.0.0",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

{ lon: 121, lat: 14.6 },\n  { lon: 127, lat: 37.6 },\n  { lon: 139.7, lat: 35.7 },\n  { lon: 135.5, lat: 34.7 },\n  { lon: 115.9, lat: -31.9 },\n  { lon: 151.2, lat: -33.9 },\n  { lon: 145, lat: -37.8 },\n  { lon: 174.8, lat: -36.8 },\n];\n\nconst STEP = 2.5;\nconst LAT_TOP = 80;\nconst LAT_BOTTOM = -57.5;\nconst COLS = Math.round(360 / STEP);\nconst ROWS = Math.round((LAT_TOP - LAT_BOTTOM) / STEP);\n\nconst EASE_IO = Easing.bezier(0.65, 0, 0.35, 1);\nconst EASE_OUT = Easing.bezier(0.22, 1, 0.36, 1);\nconst CLAMP = {\n  extrapolateLeft: \"clamp\",\n  extrapolateRight: \"clamp\",\n} as const;\n\nconst THEMES = {\n  dark: {\n    bg: \"#0A0A0B\",\n    fg: \"#F3F2EF\",\n    muted: \"#8B8A90\",\n    city: \"#FFFFFF\",\n    lift: 0.08,\n    dotAlpha: 1,\n    grain: 0.06,\n  },\n  light: {\n    bg: \"#F5F4F0\",\n    fg: \"#121214\",\n    muted: \"#6E6C67\",\n    city: \"#121214\",\n    lift: 0.3,\n    dotAlpha: 0.85,\n    grain: 0.045,\n  },\n} as const;\n\n/**\n * gradients.sh palettes, sampled per dot so the land reads as a halftone\n * screen of the gradient: \"mesh\" on dark, \"pixel-glass\" on light.\n */\nconst PALETTES = {\n  dark: {\n    reach: 0.46,\n    bg: \"#0E1645\",\n    colors: [\"#ECDCF2\", \"#2E45B7\", \"#8796EE\", \"#2E45B7\", \"#8796EE\", \"#ECDCF2\"],\n  },\n  light: {\n    reach: 0.68,\n    bg: \"#F4F3F1\",\n    colors: [\"#7A3CFF\", \"#FF4FB8\", \"#3D6BFF\"],\n  },\n} as const;\nconst BLOBS: [number, number][] = [\n  [16, 20],\n  [84, 26],\n  [72, 86],\n  [22, 80],\n  [52, 48],\n  [92, 62],\n];\n\nfunction rgb(hex: string): [number, number, number] {\n  const v = Number.parseInt(hex.slice(1), 16);\n  return [(v >> 16) & 255, (v >> 8) & 255, v & 255];\n}\n\nfunction toHex(c: [number, number, number]) {\n  return `#${c.map((v) => Math.round(v).toString(16).padStart(2, \"0\")).join(\"\")}`;\n}\n\n/** CSS-equivalent of the stacked radial layers, evaluated at (x, y) in 0–1. */\nfunction meshAt(\n  x: number,\n  y: number,\n  bg: string,\n  colors: readonly string[],\n  drift: number,\n  reach: number,\n) {\n  let c = rgb(bg);\n  for (let i = BLOBS.length - 1; i >= 0; i--) {\n    const bx = BLOBS[i][0] / 100 + 0.04 * Math.sin(drift + i * 1.7);\n    const by = BLOBS[i][1] / 100 + 0.03 * Math.cos(drift * 0.8 + i * 2.3);\n    const d = Math.hypot((x - bx) / 0.85, (y - by) / 0.95);\n    const a = Math.max(0, 1 - d / reach);\n    const k = rgb(colors[i % colors.length]);\n    c = [\n      c[0] + (k[0] - c[0]) * a,\n      c[1] + (k[1] - c[1]) * a,\n      c[2] + (k[2] - c[2]) * a,\n    ];\n  }\n  return c;\n}\n\nconst MAP_IN = -6;\nconst MAP_DUR = 26;\nconst LIGHT_AT = 20;\nconst LIGHT_SPAN = 66;\nconst RIPPLE = 26;\nconst DONE = LIGHT_AT + LIGHT_SPAN + 6;\n\nfunction hash(n: number) {\n  const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;\n  return x - Math.floor(x);\n}\n\nfunction inside(lon: number, lat: number, poly: Poly) {\n  let hit = false;\n  const n = poly.length / 2;\n  for (let i = 0, j = n - 1; i < n; j = i++) {\n    const xi = poly[i * 2];\n    const yi = poly[i * 2 + 1];\n    const xj = poly[j * 2];\n    const yj = poly[j * 2 + 1];\n    if (\n      yi > lat !== yj > lat &&\n      lon < ((xj - xi) * (lat - yi)) / (yj - yi) + xi\n    ) {\n      hit = !hit;\n    }\n  }\n  return hit;\n}\n\nfunction isLand(lon: number, lat: number) {\n  return (\n    LAND.some((p) => inside(lon, lat, p)) &&\n    !WATER.some((p) => inside(lon, lat, p))\n  );\n}\n\nfunction buildMask() {\n  const land: boolean[] = [];\n  for (let r = 0; r < ROWS; r++) {\n    for (let c = 0; c < COLS; c++) {\n      land.push(isLand(-180 + (c + 0.5) * STEP, LAT_TOP - (r + 0.5) * STEP));\n    }\n  }\n  return land;\n}\n\nconst MASK = buildMask();\n\nfunction Grain({ opacity }: { opacity: number }) {\n  const id = `g${useId().replace(/[^a-zA-Z0-9_-]/g, \"\")}`;\n  return (\n    <svg\n      width=\"100%\"\n      height=\"100%\"\n      style={{ position: \"absolute\", inset: 0, opacity, pointerEvents: \"none\" }}\n      aria-hidden\n    >\n      <filter id={id}>\n        <feTurbulence\n          type=\"fractalNoise\"\n          baseFrequency=\"0.9\"\n          numOctaves={2}\n          seed={31}\n          stitchTiles=\"stitch\"\n        />\n        <feColorMatrix values=\"0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.9 0\" />\n      </filter>\n      <rect width=\"100%\" height=\"100%\" filter={`url(#${id})`} />\n    </svg>\n  );\n}\n\nfunction snap(lon: number, lat: number) {\n  const c0 = Math.floor((lon + 180) / STEP);\n  const r0 = Math.floor((LAT_TOP - lat) / STEP);\n  let best = -1;\n  let bestD = Number.POSITIVE_INFINITY;\n  for (let dr = -2; dr <= 2; dr++) {\n    for (let dc = -2; dc <= 2; dc++) {\n      const r = r0 + dr;\n      const c = (c0 + dc + COLS) % COLS;\n      if (r < 0 || r >= ROWS || !MASK[r * COLS + c]) continue;\n      const d = dr * dr + dc * dc;\n      if (d < bestD) {\n        bestD = d;\n        best = r * COLS + c;\n      }\n    }\n  }\n  return best;\n}\n\nfunction DotMapBase({\n  count = 142,\n  label = \"countries\",\n  cities = DEFAULT_CITIES,\n  accent = \"#3B5BFD\",\n  theme = \"dark\",\n  speed = 1,\n}: DotMapProps) {\n  const t = useCurrentFrame() * speed;\n  const { width: W, height: H } = useVideoConfig();\n  const u = Math.min(W / 1280, H / 720);\n  const p = THEMES[theme];\n\n  const mapW = Math.min(W * 0.84, (H * 0.6 * COLS) / ROWS);\n  const pitch = mapW / COLS;\n  const mapH = pitch * ROWS;\n  const numSize = 124 * u;\n  const gap = 40 * u;\n  const blockH = mapH + gap + numSize * 0.9;\n  const mapX = (W - mapW) / 2;\n  const mapY = (H - blockH) / 2;\n  const r = pitch * 0.3;\n\n  const lit = useMemo(() => {\n    const seen = new Set<number>();\n    const out: { cell: number; at: number }[] = [];\n    cities.forEach((city, i) => {\n      const cell = snap(city.lon, city.lat);\n      if (cell < 0 || seen.has(cell)) return;\n      seen.add(cell);\n      const x = (city.lon + 180) / 360;\n      out.push({\n        cell,\n        at: LIGHT_AT + x * LIGHT_SPAN + (hash(i + 0.7) - 0.5) * 8,\n      });\n    });\n    return out.sort((a, b) => a.at - b.at);\n  }, [cities]);\n  const litAt = useMemo(() => {\n    const m = new Map<number, number>();\n    for (const l of lit) m.set(l.cell, l.at);\n    return m;\n  }, [lit]);\n\n  const pal = PALETTES[theme];\n  const drift = interpolate(t, [0, 135], [0, 1.2]);\n  const liftTo = rgb(theme === \"dark\" ? \"#FFFFFF\" : p.bg);\n\n  const push = interpolate(t, [0, DONE + 40], [0, 1], {\n    ...CLAMP,\n    easing: EASE_IO,\n  });\n  const scale = 0.975 + 0.03 * push;\n\n  const dots: React.ReactNode[] = [];\n  const accents: React.ReactNode[] = [];\n  for (let r0 = 0; r0 < ROWS; r0++) {\n    for (let c = 0; c < COLS; c++) {\n      const idx = r0 * COLS + c;\n      if (!MASK[idx]) continue;\n      const x = mapX + (c + 0.5) * pitch;\n      const y = mapY + (r0 + 0.5) * pitch;\n      const delay = MAP_IN + (c / COLS) * 16 + hash(idx * 0.37) * 6;\n      const a = interpolate(t, [delay, delay + MAP_DUR - 16], [0, 1], {\n        ...CLAMP,\n        easing: EASE_OUT,\n      });\n      if (a <= 0) continue;\n      const at = litAt.get(idx);\n      if (at !== undefined && t >= at) {\n        const k = interpolate(t, [at, at + 10], [0, 1], {\n          ...CLAMP,\n          easing: EASE_OUT,\n        });\n        accents.push(\n          <circle\n            key={`c${idx}`}\n            cx={x}\n            cy={y}\n            r={r * (1.2 + 0.7 * k)}\n            fill={p.city}\n          />,\n        );\n        const w = (t - at) / RIPPLE;\n        if (w < 1) {\n          const e = Easing.bezier(0.22, 1, 0.36, 1)(w);\n          accents.push(\n            <circle\n              key={`w${idx}`}\n              cx={x}\n              cy={y}\n              r={r * 1.6 + e * pitch * 2.6}\n              fill=\"none\"\n              stroke={accent}\n              strokeWidth={Math.max(1, 1.4 * u)}\n              opacity={(1 - w) * 0.8}\n            />,\n          );\n        }\n        continue;\n      }\n      const m = meshAt(\n        c / COLS,\n        r0 / ROWS,\n        pal.bg,\n        pal.colors,\n        drift,\n        pal.reach,\n      );\n      const tint: [number, number, number] = [\n        m[0] + (liftTo[0] - m[0]) * p.lift,\n        m[1] + (liftTo[1] - m[1]) * p.lift,\n        m[2] + (liftTo[2] - m[2]) * p.lift,\n      ];\n      dots.push(\n        <circle\n          key={idx}\n          cx={x}\n          cy={y}\n          r={r * (0.7 + 0.3 * a)}\n          fill={toHex(tint)}\n          opacity={a * p.dotAlpha}\n        />,\n      );\n    }\n  }\n\n  let shown = 0;\n  for (const l of lit) if (t >= l.at) shown++;\n  const value = lit.length\n    ? Math.round((count * shown) / lit.length)\n    : Math.round(count);\n  const numIn = interpolate(t, [LIGHT_AT - 8, LIGHT_AT + 8], [0, 1], {\n    ...CLAMP,\n    easing: EASE_OUT,\n  });\n  const labIn = interpolate(t, [LIGHT_AT, LIGHT_AT + 16], [0, 1], {\n    ...CLAMP,\n    easing: EASE_OUT,\n  });\n\n  return (\n    <AbsoluteFill style={{ background: p.bg, overflow: \"hidden\" }}>\n      <AbsoluteFill\n        style={{ transform: `scale(${scale})`, transformOrigin: \"50% 50%\" }}\n      >\n        <svg\n          width={W}\n          height={H}\n          style={{ position: \"absolute\", inset: 0 }}\n          aria-hidden\n        >\n          {dots}\n          {accents}\n        </svg>\n        <div\n          style={{\n            position: \"absolute\",\n            left: 0,\n            width: W,\n            top: mapY + mapH + gap,\n            display: \"flex\",\n            justifyContent: \"center\",\n            alignItems: \"baseline\",\n            gap: 18 * u,\n            whiteSpace: \"nowrap\",\n          }}\n        >\n          <span\n            style={{\n              fontFamily: manrope,\n              fontWeight: 400,\n              fontSize: numSize,\n              lineHeight: 0.9,\n              letterSpacing: \"-0.04em\",\n              color: p.fg,\n              fontVariantNumeric: \"tabular-nums\",\n              opacity: numIn,\n              transform: `translateY(${(1 - numIn) * 12 * u}px)`,\n              display: \"inline-block\",\n              minWidth: `${String(Math.round(count)).length * 0.6}em`,\n              textAlign: \"right\",\n            }}\n          >\n            {value}\n          </span>\n          <span\n            style={{\n              fontFamily: manrope,\n              fontWeight: 500,\n              fontSize: 30 * u,\n              letterSpacing: \"-0.015em\",\n              color: p.muted,\n              opacity: labIn,\n              transform: `translateY(${(1 - labIn) * 8 * u}px)`,\n              display: \"inline-block\",\n            }}\n          >\n            {label}\n          </span>\n        </div>\n      </AbsoluteFill>\n\n      <AbsoluteFill\n        style={{\n          background: `radial-gradient(ellipse 80% 80% at 50% 50%, transparent 62%, ${p.bg} 100%)`,\n          opacity: 0.6,\n          pointerEvents: \"none\",\n        }}\n      />\n      <Grain opacity={p.grain} />\n    </AbsoluteFill>\n  );\n}\n\nconst elementSchema = {\n  ...Interactive.baseSchema,\n  theme: {\n    type: \"enum\",\n    default: \"dark\",\n    variants: {\n      dark: {},\n      light: {},\n    },\n    description: \"Theme\",\n  },\n  accent: {\n    type: \"color\",\n    default: \"#3B5BFD\",\n    description: \"Accent\",\n  },\n  label: {\n    type: \"text-content\",\n    default: \"countries\",\n    description: \"Label\",\n  },\n  count: {\n    type: \"number\",\n    default: 142,\n    min: 0,\n    max: 426,\n    step: 1,\n    description: \"Count\",\n    hiddenFromList: false,\n  },\n  speed: {\n    type: \"number\",\n    default: 1,\n    min: 0.25,\n    max: 4,\n    step: 0.25,\n    description: \"Speed\",\n    hiddenFromList: false,\n  },\n  ...Interactive.transformSchema,\n} as const satisfies InteractivitySchema;\n\nconst ELEMENT_PROP_KEYS = new Set([\"theme\",\"accent\",\"label\",\"count\",\"speed\"]);\n\nconst ELEMENT_PROP_DEFAULTS: Record<string, unknown> = {\n  theme: \"dark\",\n  accent: \"#3B5BFD\",\n  label: \"countries\",\n  count: 142,\n  speed: 1,\n};\n\ntype DotMapElementProps = InteractiveBaseProps &\n  InteractiveTransformProps &\n  ComponentProps<typeof DotMapBase>;\n\nconst DotMapInner = forwardRef<\n  HTMLDivElement,\n  DotMapElementProps & { readonly controls: SequenceControls | undefined }\n>(({ controls, name, style, ...rest }, ref) => {\n  const outlineRef = useRef<HTMLDivElement>(null);\n  useImperativeHandle(ref, () => outlineRef.current as HTMLDivElement, []);\n  const componentProps: Record<string, unknown> = { ...ELEMENT_PROP_DEFAULTS };\n  const sequenceProps: Record<string, unknown> = {};\n  for (const [key, value] of Object.entries(rest)) {\n    if (ELEMENT_PROP_KEYS.has(key)) {\n      if (value !== undefined) componentProps[key] = value;\n    } else {\n      sequenceProps[key] = value;\n    }\n  }\n  return (\n    <Sequence\n      layout=\"none\"\n      {...sequenceProps}\n      controls={controls}\n      name={name ?? \"<DotMap>\"}\n      outlineRef={outlineRef}\n    >\n      <div\n        ref={outlineRef}\n        style={{\n          position: \"relative\",\n          width: \"100%\",\n          height: \"100%\",\n          display: \"flex\",\n          alignItems: \"center\",\n          justifyContent: \"center\",\n          ...style,\n        }}\n      >\n        <DotMapBase\n          {...(componentProps as unknown as ComponentProps<typeof DotMapBase>)}\n        />\n      </div>\n    </Sequence>\n  );\n});\n\nexport const DotMap = Interactive.withSchema({\n  Component: DotMapInner,\n  componentName: \"<DotMap>\",\n  componentIdentity: null,\n  schema: elementSchema,\n  supportsEffects: false,\n});\n",
